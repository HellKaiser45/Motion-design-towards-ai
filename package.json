{
  "name": "agent-stage",
  "version": "1.0.0",
  "description": "Declarative, JSON-serializable 3D/2D animation spec framework wrapping three.js + GSAP, designed for LLM/agent authoring.",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "agent-stage-mcp": "./bin/mcp-server.mjs"
  },
  "exports": "./src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "schema": "node scripts/gen-schema.mjs",
    "mcp": "node bin/mcp-server.mjs",
    "export": "node scripts/export-video.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "three": "0.186.1"
  },
  "license": "MIT"
}
