{
  "meta": { "title": "bridge demo", "background": "#0a0a0f" },
  "camera": { "position": [4, 3, 8], "lookAt": [0, 0, 0] },
  "lights": [
    { "name": "key", "type": "directional" },
    { "name": "fill", "type": "ambient", "intensity": 0.4 }
  ],
  "objects": [
    { "name": "hero", "type": "torusKnot", "material": { "preset": "neon", "color": "#22d3ee" }, "scale": 0.6 },
    { "name": "sat", "type": "sphere", "material": { "preset": "standard", "color": "#a78bfa" }, "scale": 0.25, "position": [2, 0, 0] }
  ],
  "score": [
    { "do": "animate", "to": "hero", "at": 0, "dur": 1.5, "ease": "back.out", "with": { "y": 1, "rotateY": 3.14, "scale": 1 } },
    { "do": "animate", "to": "sat", "at": 0.5, "dur": 1.5, "ease": "power2.inOut", "with": { "x": -2, "z": 2, "opacity": 0.4 } },
    { "do": "animate", "to": ["hero", "sat"], "at": 2, "dur": 1, "stagger": 0.2, "ease": "sine.inOut", "with": { "y": 0, "opacity": 1 } },
    { "do": "animate", "to": "camera", "at": 0, "dur": 3, "ease": "sine.inOut", "with": { "x": 0, "y": 1, "z": 6 } }
  ]
}
